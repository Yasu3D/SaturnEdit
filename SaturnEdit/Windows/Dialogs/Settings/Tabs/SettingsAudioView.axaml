<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icon="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SaturnEdit.Windows.Dialogs.Settings.Tabs.SettingsAudioView">
    <ScrollViewer Background="{DynamicResource BackgroundPrimary}">
        <StackPanel Margin="20">
            <!-- Hitsounds Header -->
            <Grid ColumnDefinitions="Auto,*"
                  Margin="0,0,0,20">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource VolumeMixer.Channel.Hitsounds}"
                           Margin="0,0,20,0" />
                <Rectangle Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           Height="1"
                           Fill="{DynamicResource SeparatorPrimary}" />
            </Grid>
            
            <!-- Sound Pack Selector -->
            <Grid ColumnDefinitions="250,35,35">
                <ComboBox Grid.Column="0"
                          Name="ComboBoxSoundpackList"
                          SelectionChanged="ComboBoxSoundpackList_OnSelectionChanged"/>
                
                <Button Grid.Column="1"
                        Name="ButtonAddSoundpack"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonAddSoundpack_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Settings.Audio.AddNewSoundpack}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Add" />
                </Button>
                
                <Button Grid.Column="2"
                        Name="ButtonDeleteSoundpack"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonRemoveSoundpack_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Settings.Audio.DeleteSoundpack}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Delete" />
                </Button>
            </Grid>

            <!-- Sound Pack Editor -->
            <Grid ColumnDefinitions="100,30,*,36"
                  RowDefinitions="40,20,40,40,40,40,20,40,40,20,40,40,20,40,40"
                  VerticalAlignment="Top"
                  Margin="15,10">

                <!-- Name -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Settings.Audio.SoundpackName}" />
                <TextBox Grid.Row="0"
                         Grid.Column="2"
                         Name="TextBoxName"
                         Height="30"
                         LostFocus="TextBoxName_LostFocus" />
                
                <!-- Guide -->
                <Rectangle Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Fill="{DynamicResource SeparatorPrimary}"
                           Height="1" />
                
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Guide}" />
                <icon:FluentIcon Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundGuideNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="2"
                         Grid.Column="2"
                         Name="TextBoxGuide"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="2"
                        Grid.Column="3"
                        Name="ButtonPickSoundGuide"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Touch -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Touch}" />
                <icon:FluentIcon Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundTouchNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="3"
                         Grid.Column="2"
                         Name="TextBoxTouch"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="3"
                        Grid.Column="3"
                        Name="ButtonPickSoundTouch"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Hold -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Hold}" />
                <icon:FluentIcon Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundHoldNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="4"
                         Grid.Column="2"
                         Name="TextBoxHold"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="4"
                        Grid.Column="3"
                        Name="ButtonPickSoundHold"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Slide -->
                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Slide}" />
                <icon:FluentIcon Grid.Row="5"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundSlideNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="5"
                         Grid.Column="2"
                         Name="TextBoxSlide"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="5"
                        Grid.Column="3"
                        Name="ButtonPickSoundSlide"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Bonus -->
                <Rectangle Grid.Row="6"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Fill="{DynamicResource SeparatorPrimary}"
                           Height="1" />

                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Bonus}" />
                <icon:FluentIcon Grid.Row="7"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundBonusNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="7"
                         Grid.Column="2"
                         Name="TextBoxBonus"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="7"
                        Grid.Column="3"
                        Name="ButtonPickSoundBonus"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- R -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.R}" />
                <icon:FluentIcon Grid.Row="8"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundRNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="8"
                         Grid.Column="2"
                         Name="TextBoxR"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="8"
                        Grid.Column="3"
                        Name="ButtonPickSoundR"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- StartClick -->
                <Rectangle Grid.Row="9"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Fill="{DynamicResource SeparatorPrimary}"
                           Height="1" />

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.StartClick}" />
                <icon:FluentIcon Grid.Row="10"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundStartClickNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="10"
                         Grid.Column="2"
                         Name="TextBoxStartClick"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="10"
                        Grid.Column="3"
                        Name="ButtonPickSoundStartClick"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Metronome -->
                <TextBlock Grid.Row="11"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource VolumeMixer.Channel.Metronome}" />
                <icon:FluentIcon Grid.Row="11"
                                 Grid.Column="1"
                                 Margin="0,0,10,0"
                                 Name="IconSoundMetronomeNotFound"
                                 IsVisible="True"
                                 Icon="Warning"
                                 Foreground="{DynamicResource ForegroundWarning}">
                    <ToolTip.Tip>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning}" />
                            <TextBlock Text="{DynamicResource Generic.FileNotFoundWarning.Description}"
                                       Foreground="{DynamicResource ForegroundSecondary}" />
                        </StackPanel>
                    </ToolTip.Tip>
                </icon:FluentIcon>
                <TextBox Grid.Row="11"
                         Grid.Column="2"
                         Name="TextBoxMetronome"
                         Height="30"
                         LostFocus="TextBoxSound_LostFocus" />
                <Button Grid.Row="11"
                        Grid.Column="3"
                        Name="ButtonPickSoundMetronome"
                        Classes="Themed Square Outlined"
                        HorizontalAlignment="Right"
                        Click="ButtonPickSound_OnClick">
                    <ToolTip.Tip>
                        <TextBlock Text="{DynamicResource Generic.PickFile}" />
                    </ToolTip.Tip>
                    <icon:FluentIcon Icon="Folder" />
                </Button>

                <!-- Hold Loop -->
                <Rectangle Grid.Row="12"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Fill="{DynamicResource SeparatorPrimary}"
                           Height="1" />
                
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="13"
                           Text="{DynamicResource Settings.Audio.HoldLoopStart}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />
                <NumericUpDown Grid.Column="2"
                               Grid.Row="13"
                               Name="NumericUpDownHoldLoopStart"
                               Height="30"
                               Width="200"
                               HorizontalAlignment="Left"
                               ValueChanged="NumericUpDownHoldLoopStart_OnValueChanged"
                               Minimum="0"
                               Increment="1" />
                
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Grid.Row="14"
                           Text="{DynamicResource Settings.Audio.HoldLoopEnd}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />
                <NumericUpDown Grid.Column="2"
                               Grid.Row="14"
                               Name="NumericUpDownHoldLoopEnd"
                               Height="30"
                               Width="200"
                               HorizontalAlignment="Left"
                               ValueChanged="NumericUpDownHoldLoopEnd_OnValueChanged"
                               Minimum="0"
                               Increment="1" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>